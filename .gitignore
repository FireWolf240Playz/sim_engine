# Secrets — NEVER commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next (web/.gitignore covers the rest)
node_modules/
*.tsbuildinfo

# Generated simulation output.
#
# The leading slash anchors these to the REPO ROOT. Without it, a bare
# `*.json` matches recursively and silently ignores web/package.json,
# web/package-lock.json and web/tsconfig.json — which makes a fresh clone
# unbuildable. Same reason `*.png` is anchored: web/public assets must stay
# tracked.
/*.json
/*.png

# NOTE: docs/ is intentionally TRACKED. It holds docs/AGENTS.md (the repo map
# every agent reads first), docs/HANDOFF.md, ROADMAP.md, PLAN.md and
# FOUNDER_GUIDE.md. Ignoring it left them with no history and absent from a
# clone.
